# SageApple — ATmega328P build (avr-gcc) + flash workflow (PLAN.md M4)
#
#   make            build sageapple.hex
#   make program    flash via serial bootloader (avrdude)
#   make fuse       set device fuses
#   make clean

MC       = atmega328p
B_CPU    = 16000000UL
CC       = avr-gcc
OBJCOPY  = avr-objcopy
OBJDUMP  = avr-objdump
SIZE     = avr-size
AVRDUDE  = avrdude

# Serial port used for flashing. Auto-detected from the attached boards; the
# command line still wins, e.g. `make flash DEVICE=/dev/ttyUSB1`.
PORT_GUESS := $(firstword $(wildcard /dev/ttyUSB*) $(wildcard /dev/ttyACM*))
DEVICE   ?= $(if $(PORT_GUESS),$(PORT_GUESS),/dev/ttyUSB0)
BAUD     = 115200
PROTO    = arduino

# Clone STK500v1 bootloaders drop sync mid-transfer often enough that a single
# avrdude run failing is not evidence the write failed. Retry before giving up.
FLASH_RETRIES ?= 4

# They also fail to erase the whole chip: a plain write leaves fragments of a
# previously larger image above the new one, so the chip does not match the
# build and a peek above the image returns stale bytes. Padding the image out
# to the bootloader makes avrdude touch every page below it, which erases them.
# Costs a few seconds at 115200 baud, which is worth it for a predictable chip.
# Set FLASH_CLEAR=0 for the fast path that writes only the image.
FLASH_CLEAR ?= 1

# The image actually written. It is used as a *prerequisite* as well as the
# avrdude argument, so make rebuilds it when the ELF changes.
ifeq ($(FLASH_CLEAR),1)
SAGEAPPLE_FLASH_IMAGE = sageapple_padded.hex
APPLE2_FLASH_IMAGE    = apple2_padded.hex
else
SAGEAPPLE_FLASH_IMAGE = sageapple.hex
APPLE2_FLASH_IMAGE    = apple2.hex
endif

AVRDUDE_FLAGS = -p $(MC) -c $(PROTO) -P $(DEVICE) -b $(BAUD)

# $(1) = hex file to write. Retries the whole write-and-verify cycle.
define do_flash
@i=1; while [ $$i -le $(FLASH_RETRIES) ]; do \
	if $(AVRDUDE) $(AVRDUDE_FLAGS) -U flash:w:$(1):i; then exit 0; fi; \
	echo "  attempt $$i/$(FLASH_RETRIES) failed, retrying in 2s"; \
	i=$$((i+1)); sleep 2; \
    done; \
    echo "FLASH FAILED after $(FLASH_RETRIES) attempts on $(DEVICE)"; exit 1
endef

# $(1) = hex file that was written. Reads the chip back in a *fresh* avrdude
# session -- the verify inside a write session shares the same link that can
# drop sync, which is how a stale image survives a "successful" flash.
# $(2) = scratch file for the readback.
define do_verify
	$(AVRDUDE) $(AVRDUDE_FLAGS) -q -U flash:r:$(2):i
	python3 tools_verify.py $(1) $(2)
endef

CFLAGS   = -mmcu=$(MC) -DF_CPU=$(B_CPU) -Os -Wall -Wextra -std=gnu11 -fno-strict-aliasing
ASFLAGS  = -mmcu=$(MC)
LDFLAGS  = -mmcu=$(MC) -T avr.ld

OBJS     = main.o sage6502.o bus.o rom_avr.o
ELF      = sageapple.elf
SAGE     = sage-c

# The SageLang AVR backend (avr_assembler / avr_hex) that tools/avr_boot.sage
# uses to prove the Sage -> AVR opcodes -> Intel HEX path. Override if your
# SageLang checkout is elsewhere.
SAGELANG_AVR ?= ../SageLang/core/boards/AVR
HOST_CC  = gcc
HOST_CFLAGS = -O2 -DHOST -Wall -Wextra -std=gnu11
APPLE2_OBJS = main.o sage6502.o bus_apple2.o rom_apple2.o
APPLE2_ELF = apple2.elf
APPLE2_HEX = apple2.hex
APPLE2_HOST = apple2_host_test

.PHONY: apple2 apple2-gen apple2-host apple2-host-test apple2-flash
.PHONY: verify chip-test apple2-chip-test flash-clean boot-verify boot-flash

all: $(ELF) sageapple.hex
	$(SIZE) $(ELF)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	$(CC) $(ASFLAGS) -c -o $@ $<

# rom.inc is #included by rom_avr.c and regenerated by `make rom`. The pattern
# rule cannot see that, so declare it: without this a monitor change rebuilds
# nothing and the stale ROM gets flashed.
rom_avr.o: rom.inc

$(ELF): $(OBJS) avr.ld
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

sageapple.hex: $(ELF)
	$(OBJCOPY) -O ihex -R .eeprom $< $@
	$(OBJDUMP) -d $< > sageapple.lss

$(APPLE2_ELF): apple2-gen $(APPLE2_OBJS) avr.ld
	$(CC) $(LDFLAGS) -o $@ $(APPLE2_OBJS)

$(APPLE2_HEX): $(APPLE2_ELF)
	$(OBJCOPY) -O ihex -R .eeprom $< $@
	$(OBJDUMP) -d $< > apple2.lss

apple2-gen:
	$(SAGE) ../tools/apple2_rom_gen.sage --out=rom_apple2.c

apple2: apple2-gen $(APPLE2_HEX)
	$(SIZE) $(APPLE2_ELF)

apple2-host: apple2-gen
	$(HOST_CC) $(HOST_CFLAGS) -o $(APPLE2_HOST) sage6502.c bus_apple2.c rom_apple2.c apple2_host_main.c

apple2-host-test: apple2-host
	./$(APPLE2_HOST)

apple2-flash: $(APPLE2_FLASH_IMAGE)
	$(call do_flash,$(APPLE2_FLASH_IMAGE))

# Written by `make verify`; excluded from version control by .gitignore.
READBACK = /tmp/sageapple_readback.hex
APPLE2_READBACK = /tmp/apple2_readback.hex

# First byte of the bootloader on the clone boards. Nothing below this is the
# bootloader, so padding an image out to here is safe.
BOOT_START ?= 0x7E00

# Regenerate build/boot.hex and the build/boot.asm it was assembled from.
build-sage-boot:
	cd .. && $(SAGE) -I $(SAGELANG_AVR) tools/avr_boot.sage

# Cross-check the SageLang-assembled image against GNU as/ld. The tool writes
# the source it assembled, so avr-as compiles exactly the same text.
boot-verify: build-sage-boot
	avr-as -mmcu=$(MC) ../build/boot.asm -o ../build/boot.o
	avr-ld -m avr5 -Ttext 0x0 ../build/boot.o -o ../build/boot.elf
	$(OBJCOPY) -O ihex -R .eeprom ../build/boot.elf ../build/boot_ref.hex
	python3 tools_verify.py ../build/boot.hex ../build/boot_ref.hex

# Put the SageLang-generated boot image on the board.
boot-flash: build-sage-boot
	$(call do_flash,../build/boot.hex)

# The generator writes avr/rom.inc, avr/rom_host.c and avr/host_expected.txt
# using repo-root-relative paths, so it has to run from the repo root. It also
# rewrites the recorded oracle, so treat a changed transcript as a real change
# to the monitor rather than regenerating it by accident.
rom:
	cd .. && $(SAGE) tools/rom_gen.sage

host: rom_host.c host_cmds.txt
	gcc -O2 -DHOST -o host_test sage6502.c bus.c rom_host.c host_uart.c host_main.c

# Independent check that flash really holds what we just built.
verify: sageapple.hex
	$(call do_verify,sageapple.hex,$(READBACK))

# Flash, read back, then drive the board and diff its transcript against the
# host oracle.
chip-test: $(SAGEAPPLE_FLASH_IMAGE) sageapple.hex
	$(call do_flash,$(SAGEAPPLE_FLASH_IMAGE))
	$(call do_verify,sageapple.hex,$(READBACK))
# --port is not optional here: it must be the same DEVICE avrdude just
# wrote, or the transcript gets read off whichever board guessed first.
	python3 chip_test.py --port $(DEVICE) $(CHIP_TEST_ARGS)

# The same for the reduced Apple II profile. Its boot signature is "A2\r\nHI"
# rather than a monitor banner, and the only interaction is a keypress, so the
# oracle is a single command and a configurable banner.
apple2_expected.txt: apple2-host
	./$(APPLE2_HOST) --dump > $@

apple2-chip-test: $(APPLE2_FLASH_IMAGE) $(APPLE2_HEX) apple2_expected.txt
	$(call do_flash,$(APPLE2_FLASH_IMAGE))
	$(call do_verify,$(APPLE2_HEX),$(APPLE2_READBACK))
	python3 chip_test.py --port $(DEVICE) --banner=A2 --cmds apple2_cmds.txt \
	  --expected apple2_expected.txt --terminator= $(CHIP_TEST_ARGS)

# Some clone STK500v1 bootloaders do not erase the whole chip when writing, so a
# plain flash can leave 0x00 fill or fragments of a previously larger image
# above the new one. Padding the image out to the bootloader makes avrdude
# touch every page below it, which erases them.
# Explicit rules, not a %.padded.hex pattern: a pattern rule would ask for
# sageapple_padded.elf, find nothing, and silently reuse a stale image.
sageapple_padded.hex: sageapple.hex sageapple.elf
	$(OBJCOPY) --gap-fill 0xff --pad-to $(BOOT_START) -O ihex -R .eeprom $< $@

apple2_padded.hex: $(APPLE2_HEX) apple2.elf
	$(OBJCOPY) --gap-fill 0xff --pad-to $(BOOT_START) -O ihex -R .eeprom $< $@

# Historical name. `make flash` clears pages below the bootloader by default, so
# this is now an alias rather than a separate operation. Use FLASH_CLEAR=0 to
# get the old fast write that leaves the rest of flash alone.
flash-clean: flash
	@echo "flash-clean is an alias for flash; see FLASH_CLEAR in the Makefile" 

host-test: host
	./host_test host_cmds.txt > host_out.txt
	diff host_out.txt host_expected.txt && echo "HOST EQUIVALENCE OK"

flash: $(SAGEAPPLE_FLASH_IMAGE)
	$(call do_flash,$(SAGEAPPLE_FLASH_IMAGE))

program-fuse:
	$(AVRDUDE) -p $(MC) -c $(PROTO) -P $(DEVICE) -b $(BAUD) \
	  -U lfuse:w:0xFF:m -U hfuse:w:0xD9:m -U efuse:w:0xFF:m

clean:
	rm -f *.o $(ELF) *.hex *.lss $(APPLE2_ELF) $(APPLE2_HOST) apple2_expected.txt
	rm -f sageapple_padded.hex apple2_padded.hex
	rm -f ../build/boot.hex ../build/boot.asm ../build/boot.o \
	      ../build/boot.elf ../build/boot_ref.hex
