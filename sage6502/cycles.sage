#########################################################################
## Sage6502 - Canonical NMOS 6502 Cycle Counts
##
## _CYCLES[opcode] = base cycle count for opcode
## Indexed by opcode value (0x00-0xFF)
#########################################################################

proc _atoi(s):

    var v = 0

    for i in range(len(s)):

        let ch = s[i]

        if ch >= "0" and ch <= "9":
            v = v * 10 + (ord(ch) - 48)

    return v


proc _load_cycles():

    let raw = "7,6,0,0,0,3,5,0,3,2,2,0,0,4,6,0,2,5,0,0,0,4,6,0,2,4,0,0,0,4,7,0,6,6,0,0,3,3,5,0,4,2,2,0,4,4,6,0,2,5,0,0,0,4,6,0,2,4,0,0,0,4,7,0,6,6,0,0,0,3,5,0,3,2,2,0,3,4,6,0,2,5,0,0,0,4,6,0,2,4,0,0,0,4,7,0,6,6,0,0,0,3,5,0,4,2,2,0,5,4,6,0,2,5,0,0,0,4,6,0,2,4,0,0,0,4,7,0,0,6,0,0,3,3,3,0,2,0,2,0,4,4,4,0,2,6,0,0,4,4,4,0,2,5,2,0,0,5,0,0,2,6,2,0,3,3,3,0,2,2,2,0,4,4,4,0,2,5,0,0,4,4,4,0,2,4,2,0,4,4,4,0,2,6,0,0,3,3,5,0,2,2,2,0,4,4,6,0,2,5,0,0,0,4,6,0,2,4,0,0,0,4,7,0"

    let parts = split(raw, ",")

    let t = []

    var i = 0

    while i < 256:
        if i < len(parts):
            push(t, _atoi(parts[i]))
        else:
            push(t, 0)
        i = i + 1

    return t


let _CYCLES = _load_cycles()

proc get_cycles():
    return _CYCLES
